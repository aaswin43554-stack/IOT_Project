{
  "name": "soil-monitoring-system",
  "version": "1.0.0",
  "description": "Soil Information Monitoring System",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "cd server && npm run dev",
    "dev:web": "cd web && npm run dev",
    "ingest": "cd server && npm run ingest",
    "install:all": "npm install && cd server && npm install && cd ../web && npm install",
    "lint": "eslint . && cd server && npm run lint && cd ../web && npm run lint",
    "format": "prettier --write .",
    "build": "cd web && npm install && npm run build",
    "start": "cd server && npm start"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.6",
    "chart.js": "^4.5.1",
    "lucide-react": "^0.576.0",
    "react-chartjs-2": "^5.3.1",
    "socket.io-client": "^4.8.3"
  }
}